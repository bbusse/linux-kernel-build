media: videobuf2-dma-contig: let readers finish before reuse

A capture buffer exported to a GPU goes back to the hardware writer on
QBUF without regard for the GPU still sampling it. On the pine64 Cedrus
decodes into a buffer lima is still compositing, and two regions of the
picture lag a frame behind, one per Mali pixel processor. lima puts a read
fence on every buffer it samples. Give each MMAP buffer its own dma_resv,
hand it to dma_buf_export so importers fence it, and wait on it in prepare,
which QBUF runs before the buffer reaches the driver

diff --git a/drivers/media/common/videobuf2/videobuf2-dma-contig.c b/drivers/media/common/videobuf2/videobuf2-dma-contig.c
--- a/drivers/media/common/videobuf2/videobuf2-dma-contig.c
+++ b/drivers/media/common/videobuf2/videobuf2-dma-contig.c
@@ -11,6 +11,7 @@
  */
 
 #include <linux/dma-buf.h>
+#include <linux/dma-resv.h>
 #include <linux/module.h>
 #include <linux/refcount.h>
 #include <linux/scatterlist.h>
@@ -44,6 +45,9 @@
 
 	struct vb2_buffer		*vb;
 	bool				non_coherent_mem;
+
+	struct dma_resv			resv;
+	bool				has_resv;
 };
 
 /*********************************************/
@@ -124,6 +128,10 @@
 {
 	struct vb2_dc_buf *buf = buf_priv;
 	struct sg_table *sgt = buf->dma_sgt;
+
+	if (buf->has_resv)
+		dma_resv_wait_timeout(&buf->resv, DMA_RESV_USAGE_READ, false,
+				      msecs_to_jiffies(100));
 
 	/* This takes care of DMABUF and user-enforced cache sync hint */
 	if (buf->vb->skip_cache_sync_on_prepare)
@@ -184,6 +192,8 @@
 		dma_free_attrs(buf->dev, buf->size, buf->cookie,
 			       buf->dma_addr, buf->attrs);
 	}
+	if (buf->has_resv)
+		dma_resv_fini(&buf->resv);
 	put_device(buf->dev);
 	kfree(buf);
 }
@@ -268,6 +278,9 @@
 	buf->handler.arg = buf;
 
 	refcount_set(&buf->refcount, 1);
+
+	dma_resv_init(&buf->resv);
+	buf->has_resv = true;
 
 	return buf;
 }
@@ -508,6 +521,7 @@
 	exp_info.size = buf->size;
 	exp_info.flags = flags;
 	exp_info.priv = buf;
+	exp_info.resv = &buf->resv;
 
 	if (!buf->sgt_base)
 		buf->sgt_base = vb2_dc_get_base_sgt(buf);
