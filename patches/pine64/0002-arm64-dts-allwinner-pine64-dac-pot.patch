arm64: dts: allwinner: pine64: add the Stereo Audio DAC POT board

ES9023 on i2s0 through the Pi-2 header, MCLK from the crystal on the hat,
no control bus. A linux,spdif-dit dummy codec stands in for the DAC as the
Rock64 does for its S/PDIF output

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-a64-pine64.dts b/arch/arm64/boot/dts/allwinner/sun50i-a64-pine64.dts
index 4bb62dccf..ca8a5a89c 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-a64-pine64.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-a64-pine64.dts
@@ -35,6 +35,29 @@ hdmi_con_in: endpoint {
 			};
 		};
 	};
+
+	/* Pine64 Stereo Audio DAC POT board on the Pi-2 header, ES9023 on I2S */
+	dac_codec: dac-codec {
+		compatible = "linux,spdif-dit";
+		#sound-dai-cells = <0>;
+	};
+
+	sound_dac: sound-dac {
+		compatible = "simple-audio-card";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,name = "pine64-dac-pot";
+		simple-audio-card,mclk-fs = <128>;
+
+		simple-audio-card,codec {
+			sound-dai = <&dac_codec>;
+		};
+
+		simple-audio-card,cpu {
+			sound-dai = <&i2s0>;
+			dai-tdm-slot-num = <2>;
+			dai-tdm-slot-width = <32>;
+		};
+	};
 };
 
 &codec {
@@ -99,6 +122,12 @@ hdmi_out_con: endpoint {
 	};
 };
 
+&i2s0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2s0_pins>;
+	status = "okay";
+};
+
 &i2s2 {
 	status = "okay";
 };
@@ -271,6 +300,13 @@ &simplefb_hdmi {
 	vcc-hdmi-supply = <&reg_dldo1>;
 };
 
+&pio {
+	i2s0_pins: i2s0-pins {
+		pins = "PB4", "PB5", "PB6";
+		function = "i2s0";
+	};
+};
+
 &sound_hdmi {
 	status = "okay";
 };
