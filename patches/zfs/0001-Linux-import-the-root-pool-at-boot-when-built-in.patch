 	qat.o \
 	qat_compress.o \
 	qat_crypt.o \
+	spa_boot_os.o \
 	spa_misc_os.o \
 	trace.o \
 	vdev_disk.o \
diff --git a/module/os/linux/zfs/spa_boot_os.c b/module/os/linux/zfs/spa_boot_os.c
new file mode 100644
index 0000000..544a981
--- /dev/null
+++ b/module/os/linux/zfs/spa_boot_os.c
@@ -0,0 +1,436 @@
